OPENAI_API_KEY=
# Interviewers use medium reasoning to choose the next question.
OPENAI_INTERVIEW_MODEL=gpt-6.2-astra
# Upload extraction and career recommendations use low reasoning.
OPENAI_TEXT_MODEL=gpt-6.2-sol
# OpenAI Realtime voice model for spoken interview questions.
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
# Optional override for the Pitch Perfect report model.
OPENAI_PITCH_REPORT_MODEL=gpt-6.1-sol
# Optional override for recorded Pitch Perfect answers.
OPENAI_PITCH_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Server-only RoleMatch Supabase credentials for private report and PDF saving.
SUPABASE_URL=https://ryrseyvgfmrmiqngkvxs.supabase.co
SUPABASE_SECRET_KEY=

# Reuse the Resend key and verified sender from VoiceReach. Keep disabled until
# the owner has approved the automatic email template and sending is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@voicereach.co.uk
PITCH_REPORT_OWNER_EMAIL=lee.nazari@gmail.com
PITCH_REPORT_EMAIL_ENABLED=false
